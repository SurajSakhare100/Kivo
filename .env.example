# ─── LLM Provider (Groq / OpenAI-compatible) ──────────────────────────────
# Obtain a free or paid API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# ─── Express Server & Redis ───────────────────────────────────────────────
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── Google Authentication ────────────────────────────────────────────────
# Obtain credentials from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── App Settings ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Kivo AI Builder"
NODE_ENV=development
