# ─── Server Configuration ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Allowed Frontend Origins (CORS) ─────────────────────────────────────────
# When deployed to Render, set this to your Vercel URL without a trailing slash:
# e.g., https://your-kivo-app.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── Authentication & JWT ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── LLM Provider (Groq / OpenAI-compatible) ──────────────────────────────────
# Obtain a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# ─── Redis (Optional / Fallback available) ────────────────────────────────────
# Connect to Upstash (e.g. rediss://default:...@...upstash.io:6379)
# If omitted or offline, Kivo automatically uses its built-in in-memory fallback.
REDIS_URL=redis://localhost:6379

